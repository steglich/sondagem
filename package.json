{
  "name": "sondagem",
  "version": "0.0.0",
  "private": true,
  "description": "Extensão do Chrome para testar a performance de páginas web em desenvolvimento",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/verificar-isolamento.mjs",
    "watch": "node scripts/build.mjs --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && npm run test:ui",
    "test:ui": "cd extensao/ui && ng test --no-watch",
    "test:watch": "vitest",
    "test:integracao": "playwright test",
    "pagina-teste": "node scripts/servidor-pagina-teste.mjs"
  },
  "dependencies": {
    "@angular/common": "~22.2.5",
    "@angular/compiler": "~22.2.5",
    "@angular/core": "~22.2.5",
    "@angular/platform-browser": "~22.2.5",
    "@angular/router": "~22.2.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@angular/build": "~22.2.6",
    "@angular/cli": "~22.2.6",
    "@angular/compiler-cli": "~22.2.5",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "~1.65.0",
    "@types/chrome": "*",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "esbuild": "~0.28.2",
    "eslint": "^10.14.0",
    "globals": "*",
    "jsdom": "^31.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
